ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
SOURCE_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
PREFIX := $(ROOT)/tools/m68k-elf/bin/m68k-elf-
BUILD ?= $(SOURCE_DIR)/build-actor-move
MOVE_SOURCE ?= $(SOURCE_DIR)/actor-move-reference.c
ADDRESS ?= 0x180000
FLAGS := -m68000 -msoft-float -std=c99 -Os -flto -ffreestanding -fno-pie -fno-common -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Wall -Wextra -Werror
.PHONY: actor-move
actor-move:
	mkdir -p "$(BUILD)"
	$(PREFIX)gcc $(FLAGS) -I"$(SOURCE_DIR)" -c "$(MOVE_SOURCE)" -o "$(BUILD)/body.o"
	$(PREFIX)gcc -m68000 -c "$(SOURCE_DIR)/actor-move-shim.S" -o "$(BUILD)/shim.o"
	$(PREFIX)gcc $(FLAGS) -nostdlib -Wl,--gc-sections,--defsym,NATIVE_ADDRESS=$(ADDRESS),-T,"$(SOURCE_DIR)/actor-move.ld" "$(BUILD)/body.o" "$(BUILD)/shim.o" -o "$(BUILD)/actor-move.elf"
	$(PREFIX)objcopy -O binary "$(BUILD)/actor-move.elf" "$(BUILD)/actor-move.bin"
