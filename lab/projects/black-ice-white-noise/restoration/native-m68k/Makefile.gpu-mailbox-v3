ROOT := $(abspath ../../../..)
SOURCE_DIR := ./
PREFIX := $(ROOT)/tools/m68k-elf/bin/m68k-elf-
BUILD ?= $(SOURCE_DIR)/build-gpu-mailbox
ADDRESS ?= 0x180000
MAILBOX_SOURCE ?= $(SOURCE_DIR)/gpu-mailbox-local-repair-v1.c
FLAGS := -m68000 -msoft-float -std=c99 -Os -flto -ffreestanding -fno-pie -fno-common -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Wall -Wextra -Werror
.PHONY: gpu-mailbox
gpu-mailbox:
	mkdir -p "$(BUILD)"
	"$(PREFIX)gcc" $(FLAGS) -I"$(SOURCE_DIR)" -c "$(MAILBOX_SOURCE)" -o "$(BUILD)/body.o"
	"$(PREFIX)gcc" -m68000 -c "$(SOURCE_DIR)/gpu-mailbox-shim-v3.S" -o "$(BUILD)/shim.o"
	"$(PREFIX)gcc" $(FLAGS) -nostdlib -Wl,--gc-sections,--defsym,NATIVE_ADDRESS=$(ADDRESS),-T,"$(SOURCE_DIR)/gpu-mailbox.ld" "$(BUILD)/body.o" "$(BUILD)/shim.o" -o "$(BUILD)/gpu-mailbox.elf"
	"$(PREFIX)objcopy" -O binary "$(BUILD)/gpu-mailbox.elf" "$(BUILD)/gpu-mailbox.bin"
