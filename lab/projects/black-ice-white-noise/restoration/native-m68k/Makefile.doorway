ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
SOURCE_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
PREFIX := $(ROOT)/tools/m68k-elf/bin/m68k-elf-
BUILD ?= $(SOURCE_DIR)/build-doorway
DOOR_SOURCE ?=
.PHONY: doorway
doorway:
	@test -n "$(DOOR_SOURCE)"
	mkdir -p "$(BUILD)"
	$(PREFIX)gcc -m68000 -msoft-float -std=c99 -Os -ffreestanding -fno-pie -fno-common -Wall -Wextra -Werror -I"$(SOURCE_DIR)" -c "$(DOOR_SOURCE)" -o "$(BUILD)/body.o"
	$(PREFIX)as -m68000 -o "$(BUILD)/shim.o" "$(SOURCE_DIR)/doorway-shim.S"
	$(PREFIX)ld -Ttext=0x148000 -e biwn_native_doorway -o "$(BUILD)/doorway.elf" "$(BUILD)/shim.o" "$(BUILD)/body.o"
	$(PREFIX)objcopy -O binary "$(BUILD)/doorway.elf" "$(BUILD)/doorway.bin"
