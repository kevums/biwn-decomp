THIS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
LAB_ROOT := $(abspath $(THIS_DIR)/../../../..)
CROSS ?= $(LAB_ROOT)/tools/m68k-elf/bin/m68k-elf-
BUILD ?= build-frame-reference-single-lean
CFLAGS := -m68000 -msoft-float -std=c99 -Os -ffreestanding -fno-pie -fno-common -Wall -Wextra -Werror
.PHONY: frame-reference-single-lean
frame-reference-single-lean: $(BUILD)/frame-reference-single-lean.bin
$(BUILD):
	mkdir -p $@
$(BUILD)/body.o: $(THIS_DIR)/frame-reference-single-lean.c | $(BUILD)
	$(CROSS)gcc $(CFLAGS) -c $< -o $@
$(BUILD)/shim.o: $(THIS_DIR)/frame-reference-single-lean-shim.S | $(BUILD)
	$(CROSS)as -m68000 -o $@ $<
$(BUILD)/frame-reference-single-lean.elf: $(BUILD)/shim.o $(BUILD)/body.o
	$(CROSS)ld -Ttext=0x148000 -e biwn_frame_single_lean -o $@ $^
$(BUILD)/frame-reference-single-lean.bin: $(BUILD)/frame-reference-single-lean.elf
	$(CROSS)objcopy -O binary $< $@
