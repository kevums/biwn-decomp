ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
SOURCE_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
PREFIX := $(ROOT)/tools/m68k-elf/bin/m68k-elf-
BUILD ?= $(SOURCE_DIR)/build-actor-chain
ADDRESS ?= 0x180000
MOVE_SOURCE ?= $(SOURCE_DIR)/actor-chain-move.c
COLLISION_SOURCE ?= $(SOURCE_DIR)/actor-chain-collision.c
FLAGS := -m68000 -msoft-float -std=c99 -Os -flto -ffreestanding -fno-pie -fno-common -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Wall -Wextra -Werror
.PHONY: actor-chain
actor-chain:
	mkdir -p "$(BUILD)"
	$(PREFIX)gcc $(FLAGS) -I"$(SOURCE_DIR)" -c "$(MOVE_SOURCE)" -o "$(BUILD)/move.o"
	$(PREFIX)gcc $(FLAGS) -I"$(SOURCE_DIR)" -c "$(COLLISION_SOURCE)" -o "$(BUILD)/collision.o"
	$(PREFIX)gcc -m68000 -c "$(SOURCE_DIR)/actor-chain-compact-shim.S" -o "$(BUILD)/shim.o"
	$(PREFIX)gcc $(FLAGS) -nostdlib -Wl,--gc-sections,--defsym,NATIVE_ADDRESS=$(ADDRESS),-T,"$(SOURCE_DIR)/actor-chain.ld" "$(BUILD)/move.o" "$(BUILD)/collision.o" "$(BUILD)/shim.o" -o "$(BUILD)/actor-chain.elf"
	$(PREFIX)objcopy -O binary "$(BUILD)/actor-chain.elf" "$(BUILD)/actor-chain.bin"
